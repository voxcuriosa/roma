            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3AE5a_GyLhQ3EiSmwEKv9vtOm6-Cxs58KGC1ziQ9YYtUk9m5_NJZKLeFPifDl5ZMFVZNv_Kufu8d8IA379chBZ6LKMHSuhYwegXl1KRyycO3qYOTXYqw_BRpLs8ZRw_Bfogdtqy-hHO8NMsmBgHz0ekxEIx-G1XqLS_Us1yqyWxTlM7IDUWTvG_9j8mSSyUThnsVN82bnzMF-0MvGaw?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3AE5a_GyYWODhuVhe6OT907c_cdP4VknJx5iGKzzeJtIQ64volTkRKJim9Ur_bwaEgBcnnyH1HUWBmyoGqLp-8iQ_e_BC5_w_6UDzg7fTU9cB2-GONX9kCk1ONz09JwgXcSTvGSy_HwpgU27rZM7HDUU7tyarLvwCJM4wNn_DO4JZv-_lYGSD3QgpzH-WOId5A5WlCQyTOc4qauxuIA?authuser=0&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3AE5a_GyhImQfwWPpvDjvfTctdGrrzxapqQ2V27rwgz9nP3fp0qIOIHInTb8aTBBqDh_RlfwO8yg0wkHdWZWl1uMnWEVpa2GebIyrdyD-z3i4q9cQKh_2SIhtay75iWjMDyaAswd4pyyaB_jTDxCIaZVnLED-uiVIzNqnl0kxvDE_yuA3_2X05Duw2AD_4cjgephipKv8tpqd3p_rRw?authuser=0&fife=s16383]]></value>
